NODE_PATH=src
EXTEND_ESLINT=true

# Version
# see package.json, set env before starting or building the app
REACT_APP_REPO_UI_GIT_SHA=8363dfd24a5e855ea1e726b1357bb59fe9f1ba81
REACT_APP_REPO_UI_URL=https://github.com/nervosnetwork/force-bridge-ui

# Force-Bridge Ethereum Backend RPC
REACT_APP_BRIDGE_RPC_URL=https://testnet.forcebridge.com/api/force-bridge/api/v1
# Force-Bridge Bsc Backend RPC
REACT_APP_BRIDGE_BSC_RPC_URL=https://testnet.forcebridge.com/bscapi/force-bridge/api/v1
# CKB node RPC
REACT_APP_CKB_RPC_URL=https://testnet.ckb.dev
# 0: mainnet
# 1: testnet
# 2: devnet
REACT_APP_CKB_CHAIN_ID=1

# Nervos explorer for exploring transaction
REACT_APP_TX_EXPLORER_NERVOS=https://explorer.nervos.org/aggron/transaction/
# Ethereum explorer for exploring transaction
REACT_APP_TX_EXPLORER_ETHEREUM=https://sepolia.etherscan.io/tx/
# Bsc explorer for exploring transaction
REACT_APP_TX_EXPLORER_BSC=https://testnet.bscscan.com/tx/

# Rinkeby
REACT_APP_ETHEREUM_ENABLE_CHAIN_ID=11155111
REACT_APP_ETHEREUM_ENABLE_CHAIN_NAME=Sepolia

# Bsc Testnet
REACT_APP_BSC_ENABLE_CHAIN_ID=97
REACT_APP_BSC_ENABLE_CHAIN_NAME="Binance Smart Chain Testnet"
REACT_APP_BSC_RPC_URL=https://data-seed-prebsc-1-s1.binance.org:8545/